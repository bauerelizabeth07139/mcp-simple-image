{
  "name": "dsh-simple-image",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: text-to-image through a StepFun-compatible /images/generations endpoint. It mounts the bundled zero-dependency stdio MCP server behind a small NDJSON bridge and exposes mcp__simple_image__simple_image.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/mcp-simple-image.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/mcp-simple-image#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/mcp-simple-image/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "test",
    "README.md",
    "LICENSE",
    "server.py",
    "config.example.json",
    "package.upstream.json"
  ],
  "engines": {
    "node": ">=22",
    "python": ">=3.8",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node test/bridge.test.mjs && node --import ./test/hooks.mjs test/mount.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "image-generation",
    "stepfun",
    "text-to-image"
  ]
}
